# --- Database ---------------------------------------------------------
# Local dev uses file-based SQLite so the app runs with zero setup.
# To move to Supabase: replace with the Supabase Postgres connection string
# and change `provider = "sqlite"` to `"postgresql"` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db" # or your Supabase Postgres URL

# --- Auth.js ------------------------------------------------------------
# Generated once for local dev with `openssl rand -base64 32`. Generate a
# fresh value for production and keep it secret.
AUTH_SECRET="replace-with-openssl-rand--base64-32"

# --- Not yet configured (Phase 1 runs without these) --------------------
# Resend (transactional email)
RESEND_API_KEY=""
EMAIL_FROM="The Kitchen Veendam <noreply@thekitchenveendam.nl>"

# Stripe (payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
